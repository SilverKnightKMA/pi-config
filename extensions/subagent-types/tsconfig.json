{
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"noEmit": true,
		"types": [
			"bun-types"
		],
		"allowImportingTsExtensions": true
	},
	"include": [
		"index.ts",
		"*.test.ts"
	],
	"types": [
		"@types/bun"
	]
}