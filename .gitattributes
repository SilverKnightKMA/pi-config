# Normalize text files to LF in the working tree on every platform.
# Test fixtures and multi-line string comparisons assume LF; Windows clones with
# core.autocrlf=true would otherwise convert 300+ files to CRLF and break them
# (audit #46 F4). gitattributes beats local autocrlf config.
* text=auto eol=lf

# Binaries — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
